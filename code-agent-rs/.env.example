# ============================================================
# Code Agent (CraftCoder) — 环境变量模板
# ============================================================
# 复制此文件为 .env 并填入真实值:
#   cp .env.example .env
# 或设置系统环境变量
# ============================================================

# ── 必需: LLM 模型连接 ─────────────────────────────────
LLM_API_KEY=sk-your-api-key-here
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# ── Web 服务 ────────────────────────────────────────────
WEB_PORT=3000
WEB_API_KEY=                     # 可选: 与 LLM 密钥分离的 Web 认证密钥

# ── 可选: LLM 参数 ────────────────────────────────────
LLM_TIMEOUT=120                  # 请求超时(秒)
LLM_MAX_TOKENS=65536             # 最大输出 Token

# ── 工作目录（挂载到容器 /workspace）─────────────────
WORK_DIR=./workspace

# ── 日志 ────────────────────────────────────────────────
RUST_LOG=info                    # 可选: debug, warn, error
